# --- 2.5: Matrix Dimensions ----------------------------
A <- matrix(
1:8,
nrow = 4,
ncol = 2)
# matrix dimensions
dim(A)
# if you only want number of rows:
dim(A)[1]
# Total number of elements:
length(A)
# t(A) interchanges rows and columns; `A` goes from 4x2 -> 2x4 matrix
At <- t(A)
At
dim(A)
dim(At)
C <- matrix(1:4, nrow = 2)
D <- matrix(5:8, nrow = 2)
C * D
B <- t(A) %*% A # 2 x 4 * 4 x 2 => 2 x 2
B
# If you flip order, resulting matrix would be 4 x 4
A %*% t(A)
C %*% A # inner dimensions don't correspond
A %*% C # inner dimensions do correspond
det(B)
B_inv <- solve(B)
B_inv
B_inv %*% B
G <- B %*% B_inv
diag(2) # creates an identity matrix of size 2
diag(2) == G
all.equal(G, diag(2))
diag(B)
sum(diag(B))
diag(c(2, 4, 6))
n <- 4
identity_matrix <- diag(rep(1,n))
identity_matrix
x <- rnorm(100)
n <- length(x)
y <- rep(1, 100)
t(x) %*% y
(t(x) %*% y) * 1/n
sum(x)
I = diag(n)
one = rep(1, n)
H <- I - (1/n) * one %*% t(one)
dim(H)
set.seed(123)
head(H %*% x) # returns matrix
as.numeric(head(H %*% x)) # returns vector
head(x - mean(x)) # returns vector
t(H %*% x) %*% (H %*% x) # can be written as x^T H x
t(x) %*% H %*% x
# H %*% H = H ; t(H) = H; stays itself (item potent)
sum((x - mean(x))^2)/n
